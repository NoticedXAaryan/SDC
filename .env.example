# -----------------------------------------------------------------------------
# REQUIRED ENVIRONMENT VARIABLES
# The application will fail to build or crash if these are missing.
# -----------------------------------------------------------------------------

# Database Connection (Neon, Supabase, or any PostgreSQL connection string)
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Better Auth Configuration (Authentication)
BETTER_AUTH_SECRET="generated_secret_key_here"
BETTER_AUTH_URL="https://sdc.aaaryan.space"

# Cryptography (Used for generating secure QR Passes and tokens)
PASS_SECRET="generated_secret_key_here"

# -----------------------------------------------------------------------------
# CORE INFRASTRUCTURE (Highly Recommended)
# Features like Background Queues, Rate Limiting, and full Bot Protection 
# require these to function correctly in production.
# -----------------------------------------------------------------------------

# Redis Connection (Required for BullMQ, background workers, and Rate Limiting)
REDIS_URL="redis://redis:6379"

# System Admin (Whoever signs up with this email is automatically made an Owner)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="AdminPassword123!"
ADMIN_NAME="Admin"

# Frontend / Proxy configuration (Needed for absolute links in emails/meta tags)
NEXT_PUBLIC_APP_URL="https://sdc.aaaryan.space"

# Cloudflare Turnstile (Bot Protection for Forms and Auth)
NEXT_PUBLIC_TURNSTILE_SITE_KEY="your_turnstile_site_key_here"
TURNSTILE_SECRET_KEY="your_turnstile_secret_here"

# -----------------------------------------------------------------------------
# OPTIONAL INTEGRATIONS
# You can leave these completely blank or delete them if you are not using 
# the respective features.
# -----------------------------------------------------------------------------

# Google Auth (Required only if "Sign in with Google" is enabled)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email Configuration (Required only if you want the platform to send emails)
RESEND_API_KEY=""
EMAIL_FROM_ADDRESS="hello@aaaryan.space"
EMAIL_FROM_NAME="SDC Club"

# OpenRouter AI (Required only for AI Application Grading)
OPENROUTER_API_KEY=""

# GitHub Integration (Required only for repo stats or automated issue tracking)
GITHUB_TOKEN=""
GITHUB_REPO=""

# Discord Notifications (Required only for sending alerts to a Discord channel)
DISCORD_WEBHOOK_URL=""

# PostHog Analytics (Required only for frontend user telemetry)
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST=""

# Postiz Social Media (Required only for automated social posting)
POSTIZ_API_KEY=""
POSTIZ_API_URL=""

# Sentry Error Tracking (Required only for crash reporting)
NEXT_PUBLIC_SENTRY_DSN=""

# Logging Verbosity (e.g. debug, info, warn, error)
LOG_LEVEL="info"
